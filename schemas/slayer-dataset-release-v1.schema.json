{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slayer.fabryka.ai/schemas/dataset-release-v1.json",
  "title": "Slayer Dataset Release v1",
  "type": "object",
  "required": [
    "schema_version", "object", "version", "source", "protocol", "run",
    "actors", "relations", "evidence", "claims", "claim_evidence", "attestations"
  ],
  "properties": {
    "schema_version": {"const": "slayer.ai/dataset-release/v1"},
    "object": {
      "type": "object",
      "required": ["id", "kind", "name"],
      "properties": {"kind": {"const": "dataset"}}
    },
    "version": {
      "type": "object",
      "required": ["id", "label", "digest", "payload_uri", "created_at", "created_by"]
    },
    "source": {
      "type": "object",
      "required": ["id", "archive_sha256", "repository", "revision", "origin"]
    },
    "protocol": {
      "type": "object",
      "required": ["id", "kind", "entrypoint", "git_commit", "configuration"]
    },
    "run": {
      "type": "object",
      "required": [
        "id", "protocol_version", "actor_id", "observed_started_at",
        "observed_finished_at", "inputs", "outputs", "environment"
      ]
    },
    "actors": {"type": "array", "minItems": 1},
    "relations": {"type": "array", "minItems": 3},
    "evidence": {"type": "array", "minItems": 4},
    "claims": {"type": "array", "minItems": 1},
    "claim_evidence": {"type": "array", "minItems": 1},
    "attestations": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
