SEJM_BASE_URL=https://www.sejm.gov.pl/Sejm10.nsf
SEJM_API_BASE_URL=https://api.sejm.gov.pl
# Use "api" for official Sejm API, "scrape" for direct website scraping.
DATA_SOURCE=api
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
AUDIO_SAMPLE_RATE=16000
MIN_SEGMENT_SECONDS=2.0
MAX_SEGMENT_SECONDS=30.0
OUTPUT_DIR=./datasets
# Records with fewer words than this are flagged in the quality report
# (mirrors the ISAP "too short" failure mode from the team's dataset audits).
MIN_WORD_THRESHOLD=50
# Optional: directory of *.txt reference files (e.g. exported benchmark
# texts) used for n-gram overlap decontamination checks. Leave empty to skip.
REFERENCE_CORPUS_DIR=
# Delete raw video + full-length audio after processing (several GB/day).
# Set to false only if you need to re-run segmentation without re-downloading.
CLEANUP_RAW_FILES=true
# Limit video download duration in seconds (useful for testing or disk limits).
# Leave empty to download the full session (can be 8+ hours).
VIDEO_MAX_DURATION=
# Enable video download + ASR/audio pipeline. Set to false for text-only mode
# (stenogram → speeches corpus + quality audit). Set to true for ASR datasets.
ENABLE_AUDIO_PIPELINE=false
